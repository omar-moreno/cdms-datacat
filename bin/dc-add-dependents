#!/usr/bin/env python3

import argparse
from CDMSDataCatalog import CDMSDataCatalog
from importlib.resources import files

parser = argparse.ArgumentParser()
parser.add_argument('dataset')
parser.add_argument('dep_type')
parser.add_argument('--dependents', nargs = '+')
args = parser.parse_args()

dc = CDMSDataCatalog()
dc = CDMSDataCatalog(files("CDMSDataCatalog").joinpath("cfg/prod.cfg"))
dep_datasets = [dc.get(path) for path in args.dependents] if type(args.dependents) == list else []
dc_prod.addDependents(dc.get(args.dataset), args.dep_type, dep_datasets = dep_datasets)

