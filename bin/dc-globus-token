#!/usr/bin/env python

import argparse
from CDMSDataCatalog import get_access_token_globus

parser = argparse.ArgumentParser()
parser.add_argument('client_id')
parser.add_argument('--consent_data_access')
args = parser.parse_args()

if type(args.consent_data_access) == str:
    print(get_access_token_globus(args.client_id, endpoint_id_consent = args.consent_data_access))
else:
    print(get_access_token_globus(args.client_id))
