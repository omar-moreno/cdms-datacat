#!/usr/bin/env python3

import argparse
from CDMSDataCatalog import CDMSDataCatalog

parser = argparse.ArgumentParser()
parser.add_argument('datasets', nargs = '+')
parser.add_argument('--checkonly', type = bool)
parser.add_argument('--dest')
parser.add_argument('--destRelative', action = 'store_true')
parser.add_argument('--force', action = 'store_true')
args = parser.parse_args()

dc = CDMSDataCatalog()
datasets = dc.fetch(args.datasets, checkonly = args.checkonly, dest = args.dest, destRelative = args.destRelative, force = args.force)
for ds in datasets:
    print(ds.filePath)
