#!/usr/bin/env python

import click
import inspect

from CDMSDataCatalog import DMCintermediate


def options_from_class(cls):
    """
    Given an input class, creates Click options based on the arguments
    of the constructors of the class.
    """

    def decorator(f):
        for par in inspect.signature(cls.__init__).parameters.values():
            if par.name not in ["self"]:
                click.option("--" + par.name, par.name, required=True, type=par.annotation)(f)
        return f

    return decorator


@click.group()
def cli():
    pass


@cli.command()
@options_from_class(DMCintermediate)
def dmcintermediate(**kwargs):
    click.echo("Creating DMCintermediate with arguments: {}".format(kwargs))
    dataset = DMCintermediate(**kwargs)


if __name__ == "__main__":
    cli()
