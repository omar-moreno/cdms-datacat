#!/usr/bin/env python3

import argparse
import pkg_resources
from CDMSDataCatalog import CDMSDataCatalog, CDMSDataset

parser = argparse.ArgumentParser()
parser.add_argument('name')
parser.add_argument('filePath')
parser.add_argument('dataType')
parser.add_argument('site')
parser.add_argument('fileFormat')
parser.add_argument('--relativePath')
parser.add_argument('--metadata', nargs = '+')
args = parser.parse_args()

dc_prod = CDMSDataCatalog(pkg_resources.resource_filename('CDMSDataCatalog', 'cfg/prod.cfg'))
if type(args.relativePath) == str: # relativePath muest be mandatory until any type of dataset is supported...
    ds = CDMSDataset(args.name, args.filePath, args.dataType, args.site, args.fileFormat)
    ds.relativePath = args.relativePath
    for item in args.metadata:
        parts = item.split(':')
        if len(parts) == 2:
            k = parts[0]
            parts = parts[1].split('/')
            if len(parts) == 2:
                if parts[1] == 's':
                    ds.metadata[k] = parts[0]
                elif parts[1] == 'i':
                    ds.metadata[k] = int(parts[0])
    if len(ds.metadata.keys()) == len(args.metadata):
        dc_prod.add(ds)

# TO-DO: support any type of dataset (currently only CDMSDataset base class)
# TO-DO: include option to enter metadata from text file
