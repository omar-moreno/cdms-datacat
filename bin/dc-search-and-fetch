#!/usr/bin/env python

import argparse
from CDMSDataCatalog import CDMSDataCatalog

parser = argparse.ArgumentParser()
parser.add_argument('path')
parser.add_argument('--site', default = 'All')
parser.add_argument('--query')
parser.add_argument('--checkonly', type = bool)
parser.add_argument('--dest')
parser.add_argument('--noDestRelative', action = 'store_true')
parser.add_argument('--force', action = 'store_true')
args = parser.parse_args()

dc = CDMSDataCatalog()
datasets = dc.search(args.path, site = args.site, query = args.query)
datasets = dc.fetch(datasets, checkonly = args.checkonly, dest = args.dest, destRelative = not args.noDestRelative, force = args.force)
for ds in datasets:
    print(ds.filePath)
