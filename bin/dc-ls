#!/usr/bin/env python3

import argparse
from CDMSDataCatalog import CDMSDataCatalog

def main():
    """
    """
    parser = argparse.ArgumentParser()
    parser.add_argument("path",
                        nargs="?",
                        default="/CDMS",
                        help="Path in the CDMS data catalog to list (default: /CDMS)")

    args = parser.parse_args()

    dc = CDMSDataCatalog()
    for item in dc.ls(args.path):
        print(item)

if __name__ == "__main__":
    main()
