#!/usr/bin/env python

import sys
from CDMSDataCatalog import register, build_dict_metadata_swft

txtFile_data = sys.argv[1]
site = sys.argv[2]
fileFormat = sys.argv[3]
txtFile_metadata_dataset = sys.argv[4]
txtFile_metadata_folder = sys.argv[5]
dry_run = '--dry_run' in sys.argv[6:]

def read_text_file(txtFile):
    lines = []
    f = open(txtFile)
    for line in f.readlines():
        lines.append(line.replace('\n', ''))
    f.close()
    return lines

filePaths_data = read_text_file(txtFile_data)
filePaths_metadata_dataset = read_text_file(txtFile_metadata_dataset)
filePaths_metadata_folder = read_text_file(txtFile_metadata_folder)

if len(filePaths_data) != len(filePaths_metadata_dataset):
    print('ERROR: number of dataset metadata files does not match number of data files')
elif len(filePaths_data) > 0 and len(filePaths_metadata_folder) == 0:
    print('ERROR: no folder metadata file provided')
elif len(filePaths_metadata_folder) > 1:
    print('ERROR: multiple folder metadata files provided (requiring only one folder metadata file)')
else:
    for i in range(len(filePaths_data)):
        dict_metadata = build_dict_metadata_swft(site, fileFormat, filePaths_metadata_dataset[i], filePaths_metadata_folder[0])
        print('INFO from dc-register-swft: data file', str(i+1)+',', 'metadata =', dict_metadata)
        if dry_run:
            register(filePaths_data[i], dict_metadata, dry_run = True)
        else:
            register(filePaths_data[i], dict_metadata)
