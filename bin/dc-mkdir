#!/usr/bin/env python3

import argparse
from importlib.resources import files

from datacat.model import Metadata

from CDMSDataCatalog import CDMSDataCatalog


def parse_metadata(metadata_entries):
    """
    Parse a list of metadata entries in the format key:value/type into a Metadata object.

    Each entry must be formatted as:
        key:value/type

    Supported types:
        - 's' for string
        - 'i' for integer

    Example:
        title:MyDataset/s author_id:42/i

    Args:
        metadata_entries (list of str): Metadata entries to parse.

    Returns:
        Metadata: A dictionary-like object with the parsed key-value pairs.
    """
    metadata = Metadata()
    for entry in metadata_entries:
        parts = entry.split(":")
        if len(parts) != 2:
            print(
                f"Metadata entry '{entry}' is not formatted correctly. Expected: key:value/type"
            )
            continue

        key, value = parts
        value_parts = value.split("/")

        if len(value_parts) != 2:
            print(
                f"Metadata value '{value}' is not formatted correctly. Expected: value/type"
            )
            continue

        value, type_hint = value_parts

        if type_hint == "s":
            metadata[key] = value
        elif type_hint == "i":
            try:
                metadata[key] = int(value)
            except ValueError:
                print(f"Invalid integer value for key '{key}': '{value}'")
        else:
            print(f"Unsupported type '{type_hint}' for value '{value}'")

    return metadata


def main():
    """
    Creates a new directory (container)  in the CDMS Data Catalog at the specified path, with optional metadata.

    Command-line Arguments:
        path (str): Required. The full path to the new directory in the data catalog.
        --parents (bool): Optional. Create parent directories if they don't exist.
        --metadata (list of str): Optional. Metadata entries in the format key:value/type where 'type' is 's' (string) or 'i' (integer)

    Example usage:
        dc-mkdir /CDMS/Scratch/Test --parents --metadata title:Test/s version:1/i

    Output:
        - Creates the folder in the data catalog.
        - Prints an error if the folder already exists or if metadata is invalid.
    """
    parser = argparse.ArgumentParser()
    parser.add_argument("path", help="Full path to the new directory.")
    parser.add_argument(
        "--parents",
        action="store_true",
        help="Create parent directories if needed",
    )
    parser.add_argument(
        "--metadata",
        nargs="+",
        help="Metadata entries in the form key:value/type",
    )

    args = parser.parse_args()

    dc_prod = CDMSDataCatalog(files("CDMSDataCatalog").joinpath("cfg/prod.cfg"))

    metadata = parse_metadata(args.metadata or [])

    if len(metadata) == len(args.metadata or []):
        try:
            dc_prod.mkdir(args.path, parents=args.parents, metadata=metadata)
        except:
            print(
                f"Error: The directory '{args.path}' may already exist or an unknown error occurred."
            )
    else:
        print(
            "Error: Failed to create the directory. Some metadata entries were invalid."
        )


if __name__ == "__main__":
    main()
