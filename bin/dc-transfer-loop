#!/usr/bin/env python

import argparse
from CDMSDataCatalog import transfer_ssh, transfer_globus, build_dict_metadata_swft

parser = argparse.ArgumentParser()
parser.add_argument('txtFile_data')
parser.add_argument('txtFile_metadata_dataset')
parser.add_argument('txtFile_metadata_folder')
parser.add_argument('basedir')
parser.add_argument('--ssh', action = 'store_true')
parser.add_argument('--user')   # ssh
parser.add_argument('--remote') # ssh
parser.add_argument('--globus', action = 'store_true')
parser.add_argument('--client_id')          # globus
parser.add_argument('--source_endpoint_id') # globus
parser.add_argument('--dest_endpoint_id')   # globus
parser.add_argument('--save')
args = parser.parse_args()

def read_text_file(txtFile):
    lines = []
    f = open(txtFile)
    for line in f.readlines():
        lines.append(line.replace('\n', ''))
    f.close()
    return lines

filePaths_data = read_text_file(args.txtFile_data)
filePaths_metadata_dataset = read_text_file(args.txtFile_metadata_dataset)
filePaths_metadata_folder = read_text_file(args.txtFile_metadata_folder)

list_dict_metadata = []
if len(filePaths_data) != len(filePaths_metadata_dataset):
    print('ERROR: number of dataset metadata files does not match number of data files')
elif len(filePaths_data) > 0 and len(filePaths_metadata_folder) == 0:
    print('ERROR: no folder metadata file provided')
elif len(filePaths_metadata_folder) > 1:
    print('ERROR: multiple folder metadata files provided (requiring only one folder metadata file)')
else:
    for i in range(len(filePaths_data)):
        list_dict_metadata.append(build_dict_metadata_swft('SLAC', 'txt', filePaths_metadata_dataset[i], filePaths_metadata_folder[0])) # Actual values of site and fileFormat are not required here

filePaths_remote = None
if args.ssh:
    if type(args.user) == str and type(args.remote) == str:
        filePaths_remote = transfer_ssh(filePaths_data, list_dict_metadata, args.user, args.remote, args.basedir)
    else:
        print('ERROR: missing optional arguments required by --ssh flag: --user, --remote')
elif args.globus:
    if type(args.client_id) == str and type(args.source_endpoint_id) == str and type(args.dest_endpoint_id) == str:
        filePaths_remote = transfer_globus(filePaths_data, list_dict_metadata, args.client_id, args.source_endpoint_id, args.dest_endpoint_id, args.basedir)
    else:
        print('ERROR: missing optional arguments required by --globus flag: --client_id, --source_endpoint_id, --dest_endpoint_id')

if type(args.save) == str and type(filePaths_remote) == list:
    f = open(args.save, 'w')
    for filePath in filePaths_remote:
        f.write(filePath+'\n')
    f.close()
